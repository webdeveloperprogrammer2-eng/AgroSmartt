{
  // Cloudflare Workers Assets — SPA-и Vite.
  // Роҳгардонии React Router тавассути `not_found_handling` анҷом мешавад,
  // на тавассути `_redirects` (Cloudflare қоидаи `/* -> /index.html`-ро
  // ҳамчун давраи беохир рад мекунад).
  "name": "agrosmartt",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
